# Copy to .env and adjust. Values below run a local demo with no real money.

NODE_ENV=development
PORT=4000
# Public base URL used in checkout links and the Telegram webhook.
PUBLIC_URL=http://localhost:4000

# --- Storage -------------------------------------------------------------
# Leave empty for in-memory storage (data lost on restart). Required in production.
# DATABASE_URL=postgres://bayamsafe:bayamsafe@localhost:5432/bayamsafe

# --- Security ------------------------------------------------------------
# Encrypts release codes and hashes buyer links. Required in production (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# APP_SECRET=
# Bearer key for /api/admin/* (24+ chars).
# ADMIN_API_KEY=
# Comma-separated Telegram user ids allowed to approve riders/KYC and receive alerts.
# ADMIN_TELEGRAM_IDS=123456789

# --- Telegram ------------------------------------------------------------
# Create a bot with @BotFather. Leave empty to run the API without the bot.
# TELEGRAM_BOT_TOKEN=
# In production prefer a webhook (needs a public HTTPS PUBLIC_URL):
# TELEGRAM_USE_WEBHOOK=true
# TELEGRAM_WEBHOOK_SECRET=

# --- Payments ------------------------------------------------------------
# "simulated" for local testing (a test button approves payments), "campay" for real money.
PAYMENT_PROVIDER=simulated
# CAMPAY_BASE_URL=https://demo.campay.net/api   # sandbox; live: https://www.campay.net/api
# CAMPAY_USERNAME=
# CAMPAY_PASSWORD=
# CAMPAY_WEBHOOK_KEY=
# In the Campay dashboard, set the webhook URL to PUBLIC_URL/api/webhooks/campay

# --- Business rules ------------------------------------------------------
PLATFORM_COMMISSION_PCT=2.5
ORDER_PAYMENT_TTL_HOURS=48
DISPATCH_RADIUS_KM=8
MAX_CODE_ATTEMPTS=3

# Creates a demo merchant, two riders and one order on start (never in production).
SEED_DEMO_DATA=true

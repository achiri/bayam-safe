# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.ngrok-free.app/api/webhooks/telegram

# Payment Gateway Sandbox (Campay / Notch Pay)
PAYMENT_GATEWAY_PROVIDER=campay_sandbox # options: campay_sandbox, mock, notchpay_sandbox
CAMPAY_APP_USERNAME=demo_sandbox_user
CAMPAY_APP_PASSWORD=demo_sandbox_password
CAMPAY_ENVIRONMENT=DEV # DEV or PROD

# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:4000
NODE_ENV=development

# Commission & Fees
ESCROW_FEE_PERCENTAGE=2.5 # 2.5% split between buyer & seller
DEFAULT_CURRENCY=XAF
